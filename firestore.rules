rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLiraaForm(data) {
      return data.ownerId is string && data.ownerId.size() <= 128 &&
             data.cabecalho is map &&
             data.linhas is list && data.linhas.size() <= 150;
    }

    match /liraa_forms/{formId} {
      allow get: if isValidId(formId) && (
        (isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.ownerId == 'shared')) ||
        resource.data.ownerId == 'public'
      );
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(formId) && incoming().ownerId == request.auth.uid && isValidLiraaForm(incoming());
      allow update: if isSignedIn() && isValidId(formId) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId && isValidLiraaForm(incoming());
      allow delete: if isSignedIn() && isValidId(formId) && existing().ownerId == request.auth.uid;
    }
  }
}
